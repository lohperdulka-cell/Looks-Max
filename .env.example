# --- Общее ---
APP_NAME=FaceMetric
APP_ENV=local
DEBUG=true
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-in-production

# --- База данных ---
# Локально (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/facemetric.db
# Прод (Postgres):
# DATABASE_URL=postgresql+asyncpg://facemetric:facemetric@localhost:5432/facemetric
DB_ECHO=false

# --- JWT / auth ---
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Файлы ---
MAX_UPLOAD_MB=12

# --- ML ---
ML_ENABLED=true
# MediaPipe основной (≈240 МБ RSS, 478 точек, тянет только 3.6 МБ .task).
# InsightFace — резерв (точнее по антропометрии, даёт пол/возраст), но качает
# 280 МБ весов, поэтому только с обрезкой моделей (см. ниже).
ML_PROVIDER_PRIMARY=mediapipe
ML_PROVIDER_FALLBACK=insightface
# Какие модели buffalo_l грузить. Полный набор = 5 моделей и пик ~920 МБ RSS
# (OOM при лимите 512 МБ). Нужны только эти три: детектор, 106 точек,
# пол/возраст. 1k3d68.onnx (137 МБ) и w600k_r50.onnx (166 МБ) не используются.
ML_INSIGHTFACE_MODULES=detection,landmark_2d_106,genderage
ML_LAZY_LOAD=true
# Демо-провайдер: синтетическая 106-точечная сетка, если детекторы недоступны
# (например, на Render free). Конвейер работает, но баллы не описывают внешность.
ML_PROVIDER_DEMO=false

# --- LLM (ИИ-консультант) ---
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Внешние сервисы (опционально) ---
SENTRY_DSN=
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# --- Почта (заглушка) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@facemetric.local
