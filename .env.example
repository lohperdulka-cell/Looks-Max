# --- Общее ---
APP_NAME=FaceMetric
APP_ENV=local
DEBUG=true
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-in-production

# --- База данных ---
# Локально (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/facemetric.db
# Прод (Postgres):
# DATABASE_URL=postgresql+asyncpg://facemetric:facemetric@localhost:5432/facemetric
DB_ECHO=false

# --- JWT / auth ---
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Файлы ---
MAX_UPLOAD_MB=12

# --- ML ---
ML_ENABLED=true
ML_PROVIDER_PRIMARY=insightface
ML_PROVIDER_FALLBACK=mediapipe
ML_LAZY_LOAD=true

# --- LLM (ИИ-консультант) ---
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Внешние сервисы (опционально) ---
SENTRY_DSN=
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# --- Почта (заглушка) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@facemetric.local
